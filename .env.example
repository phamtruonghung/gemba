# Copy to .env and fill in. Read by both the systemd deployment (/etc/gemba/gemba.env) and
# `docker compose` (this file, via env_file). Never commit it.
#
# Front gate. Set BOTH before putting this on any hostname: the ask form calls a paid model on
# every question, so an instance reachable from the internet without them is an open bill.
GEMBA_USER=
GEMBA_PASS=

# The answer model. Default gateway: OpenCode (the same one this project's own agent runs on) —
# it speaks the OpenAI-compatible protocol and needs the x-opencode-session header that src/llm.mjs
# sends. An OpenRouter key works too: set the base URL and the matching model id. Without a key the
# AI tier runs in a labelled extractive mode (it quotes the
# closest note and says so) instead of failing — the demo never fabricates a model answer.
GEMBA_LLM_KEY=
GEMBA_LLM_BASE_URL=https://opencode.ai/zen/go/v1
GEMBA_LLM_MODEL=deepseek-v4.1-flash
# One stable id per installation; the installer mints it. The gateway routes usage by this.
GEMBA_LLM_SESSION=

# Optional: a serving account for the VietQR transfer instruction. Leave empty and the booking
# page shows the amount with no QR code.
GEMBA_BANK_BIN=
GEMBA_BANK_ACCOUNT=

# Optional: pin the operator-console token. Left empty, one is generated into
# <data dir>/admin.token on first start.
GEMBA_ADMIN_TOKEN=

# Host port only (the container always listens on 8090 internally).
GEMBA_HOST_PORT=8090
